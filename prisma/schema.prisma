generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  bio           String?   @default("")
  jobTitle      String?   @default("")
  timezone      String?   @default("UTC")
  notifyOnAssign Boolean? @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   OrganizationMember[]
  projects      Project[]    @relation("ProjectOwner")
  tasks         Task[]       @relation("TaskAssignee")
  activities    Activity[]
  invites       Invite[]     @relation("InvitedBy")
  emailLogs     EmailLog[]
  chatParticipants ChatParticipant[]
  messages         Message[]        @relation("SentMessages")
  notifications    Notification[]
  callsInitiated   Call[]           @relation("Caller")
  callsReceived    Call[]           @relation("Receiver")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  smtpHost  String?
  smtpPort  Int?
  smtpUser  String?
  smtpPass  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  projects       Project[]
  invites        Invite[]
  emailContacts  EmailContact[]
  emailLogs      EmailLog[]
  chats          Chat[]
}

model OrganizationMember {
  id        String   @id @default(cuid())
  role      String   @default("member")
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  tasks      Task[]
  activities Activity[]
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  status      String   @default("todo")
  priority    String   @default("medium")
  order       Float    @default(0)
  dueDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId      String?
  assignee        User?       @relation("TaskAssignee", fields: [assigneeId], references: [id])
  submissionLink  String?     @default("")
  activities      Activity[]
}

model Invite {
  id             String    @id @default(cuid())
  email          String
  token          String    @unique
  status         String    @default("pending")
  role           String    @default("member")
  expiresAt      DateTime
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitedBy", fields: [invitedById], references: [id])
}

model EmailContact {
  id        String   @id @default(cuid())
  email     String
  name      String?
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model EmailLog {
  id        String    @id @default(cuid())
  to        String
  subject   String
  status    String    @default("pending")
  method    String?
  error     String?
  metadata  String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  invitedById String?
  invitedBy   User?    @relation(fields: [invitedById], references: [id])
}

model Activity {
  id        String   @id @default(cuid())
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  projectId String?
  project  Project? @relation(fields: [projectId], references: [id])
  taskId   String?
  task     Task?    @relation(fields: [taskId], references: [id])
}

model Chat {
  id        String   @id @default(cuid())
  name      String?  // group name (null for 1-on-1)
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  participants ChatParticipant[]
  messages     Message[]
  calls        Call[]
}

model ChatParticipant {
  id     String @id @default(cuid())
  chatId String
  userId String

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model Message {
  id        String         @id @default(cuid())
  content   String?
  createdAt DateTime       @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  readAt    DateTime?

  senderId String
  chatId   String

  attachments MessageAttachment[]

  sender User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model MessageAttachment {
  id        String   @id @default(cuid())
  type      String   // "image" | "video" | "audio" | "document"
  name      String
  data      String   // base64 encoded file data
  size      Int
  createdAt DateTime @default(now())

  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  title     String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Call {
  id         String     @id @default(cuid())
  status     String     @default("ringing") // ringing, ongoing, ended, missed
  isVideo    Boolean    @default(false)
  offer      String?    // SDP offer JSON
  answer     String?    // SDP answer JSON
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime   @default(now())

  callerId   String
  caller     User    @relation("Caller", fields: [callerId], references: [id], onDelete: Cascade)

  receiverId String
  receiver   User    @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  chatId String?
  chat   Chat?   @relation(fields: [chatId], references: [id], onDelete: SetNull)

  iceCandidates CallICECandidate[]
}

model CallICECandidate {
  id        String   @id @default(cuid())
  type      String   // "caller" | "receiver"
  candidate String   // ICE candidate JSON
  createdAt DateTime @default(now())

  callId String
  call   Call @relation(fields: [callId], references: [id], onDelete: Cascade)
}
